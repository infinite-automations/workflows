{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>infinite-automations/renovate-configs", ":automergeAll"],
  "ignorePaths": ["test/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned versions in workflow input defaults",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s+\\S+:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
