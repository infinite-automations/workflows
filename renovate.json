{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>infinite-automations/renovate-configs",
    "github>infinite-automations/renovate-configs:customManagers/workflowVersionPin",
    "github>infinite-automations/renovate-configs:customManagers/commentManager(/^docs/.+\\.md$/)",
    ":automergeAll"
  ],
  "ignorePaths": ["test/**"],
  "packageRules": [
    {
      "description": "Keep the preset compatible with the release-notes generator's changelog writer",
      "matchPackageNames": ["conventional-changelog-conventionalcommits"],
      "allowedVersions": "<8.0.0"
    }
  ]
}
