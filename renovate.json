{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>infinite-automations/renovate-configs:default",
    ":automergeMinor",
    ":automergeDigest",
    ":automergePatch"
  ],
  "ignorePaths": ["test/**"],
  "labels": ["dependencies"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned versions in workflow input defaults",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\n\\s+\\S+:\\n\\s+description:[^\\n]+\\n\\s+required:[^\\n]+\\n\\s+type:[^\\n]+\\n\\s+default:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Group npm dev dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "npm-dev-dependencies",
      "automerge": true
    },
    {
      "description": "Group pip dependencies",
      "matchManagers": ["pip_requirements"],
      "groupName": "pip-dependencies",
      "automerge": true
    }
  ]
}
