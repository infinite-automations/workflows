{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>infinite-automations/renovate-configs",
    "github>infinite-automations/renovate-configs:customManagers/workflowVersionPin",
    ":automergeAll"
  ],
  "ignorePaths": ["test/**"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned semantic-release plugins",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yml$/",
        "/^docs/.+\\.md$/"
      ],
      "matchStrings": [
        "(?<depName>(?:@[^/\\s]+/)?[^@\\s]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm"
    }
  ]
}
