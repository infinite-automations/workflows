{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    "@semantic-release/changelog",
    [
      "semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "files": ["docs/**/*.md"],
            "from": "infinite-automations/workflows/\\.github/workflows/([^@\\s]+)@(?:VERSION|vMAJOR|v[0-9]+\\.[0-9]+\\.[0-9]+)",
            "to": "infinite-automations/workflows/.github/workflows/$1@v${nextRelease.version}",
            "countMatches": true
          },
          {
            "files": ["README.md"],
            "from": "infinite-automations/workflows/\\.github/workflows/([^@\\s]+)@(?:VERSION|vMAJOR|v[0-9]+\\.[0-9]+\\.[0-9]+)",
            "to": "infinite-automations/workflows/.github/workflows/$1@v${nextRelease.version}",
            "countMatches": true
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "docs/**/*.md", "README.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    "@semantic-release/github",
    [
      "semantic-release-major-tag",
      {
        "customTags": ["v${major}", "v${major}.${minor}"]
      }
    ]
  ]
}
